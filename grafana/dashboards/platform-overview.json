      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"apps\", product=~\"$product\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
